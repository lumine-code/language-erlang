{
  "name": "Erlang",
  "scopeName": "source.erlang",
  "type": "tree-sitter",
  "parser": "tree-sitter-erlang",
  "injectionNames": ["erlang"],
  "fileTypes": ["erl", "hrl", "escript"],
  "comments": {
    "start": "% "
  },
  "treeSitter": {
    // Pin a tag or a full SHA, never a branch. Verify the ref is on the main
    // line before trusting it — `gh api repos/OWNER/REPO/compare/<ref>...HEAD`
    // reporting `diverged` or a nonzero `behind` means it is not.
    "parserSource": "github:WhatsApp/tree-sitter-erlang#0.20",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "erlang.wasm",
    "highlightsQuery": "erlang-highlights.scm"
  }
}
